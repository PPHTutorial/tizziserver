# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*

# build / cache
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
coverage/

# prisma generated client
packages/db/src/generated/
packages/db/generated/

# next
next-env.d.ts

# env
.env
.env.*
!.env.example

# local dev postgres cluster (scripts/dev-postgres.mjs) + env backups
.pgdata/

# STORAGE_PROVIDER=mock local object-storage sandbox (packages/core/src/storage)
.storage-mock/

# Next 16 auto-generated agent rule files
apps/api/AGENTS.md
apps/api/CLAUDE.md

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel

# flutter (mobile/)
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/**/generated_plugin_registrant.*

# generated design tokens (built by packages/tokens/build.mjs)
packages/tokens/dist/
mobile/lib/design/tokens.g.dart

# figma export: keep the mined tokens + manifest + renders, drop the giant raw dumps
docs/design/**/file.json
docs/design/**/nodes/

# Playwright (apps/api/e2e)
apps/api/test-results/
apps/api/playwright-report/
apps/api/blob-report/
apps/api/playwright/.cache/

# Terraform (infra/terraform, incl. selfhost/) — local provider cache,
# state, and real vars. terraform.tfvars.example and .terraform.lock.hcl ARE
# tracked. The ** prefix makes these apply in every subdirectory (each
# module — root GCP+Cloudflare, selfhost/ — inits its own .terraform/).
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/*.tfvars
!infra/terraform/**/*.tfvars.example
infra/terraform/**/crash.log
infra/terraform/**/override.tf
infra/terraform/**/override.tf.json