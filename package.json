{
  "name": "stall",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @stall/db generate",
    "db:migrate": "pnpm --filter @stall/db migrate",
    "db:studio": "pnpm --filter @stall/db studio",
    "db:seed": "pnpm --filter @stall/db seed",
    "figma:pull": "node scripts/figma-pull.mjs",
    "figma:tokens": "node scripts/figma-extract-tokens.mjs",
    "dev:db": "node scripts/dev-postgres.mjs start",
    "dev:db:stop": "node scripts/dev-postgres.mjs stop",
    "dev:mail": "maildev --smtp 1025 --web 1080 --hide-extensions STARTTLS",
    "dev:redis": "redis-server --port 6379 --save \"\" --appendonly no"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
    "maildev": "^2.2.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
