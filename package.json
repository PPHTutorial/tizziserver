{
  "name": "grandprice",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @grandprice/db generate",
    "db:migrate": "pnpm --filter @grandprice/db migrate",
    "db:studio": "pnpm --filter @grandprice/db studio",
    "db:seed": "pnpm --filter @grandprice/db seed",
    "figma:pull": "node scripts/figma-pull.mjs",
    "figma:tokens": "node scripts/figma-extract-tokens.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv-cli": "^8.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
