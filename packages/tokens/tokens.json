{
  "$description": "GrandPrice design tokens — measured from the 64-frame Figma export (docs/design/Untitled/extracted-tokens.json) and docs/03-DESIGN-SYSTEM.md. Dark values are derived (no dark theme in Figma) and pending review.",
  "color": {
    "brand": {
      "50": "#FFF4EC", "100": "#FFF0E6", "200": "#FFE1C7",
      "400": "#FF8A3D", "500": "#FF6200", "600": "#E5560A", "700": "#C61F00"
    },
    "ink": { "hi": "#111111", "900": "#121212" },
    "neutral": {
      "bg": "#FAF9F6", "100": "#F2F0EC", "200": "#EFECE8", "300": "#E9E7E2",
      "textMed": "#555555", "textLow": "#8E8E93"
    },
    "success": { "500": "#00B050", "container": "#E6F7ED" },
    "gold": { "500": "#FFB800", "600": "#B38600", "container": "#FFF9E6" },
    "error": { "500": "#FF3B30", "container": "#FFECEB" },
    "gradient": { "brandFrom": "#FF5C00", "brandTo": "#C61F00" }
  },
  "semantic": {
    "light": {
      "bg": "{color.neutral.bg}",
      "surface": "#FFFFFF",
      "surfaceSunken": "{color.neutral.100}",
      "border": "{color.neutral.200}",
      "borderStrong": "{color.neutral.textLow}",
      "overlay": "rgba(17,17,17,0.45)",
      "textHi": "{color.ink.hi}",
      "textMed": "{color.neutral.textMed}",
      "textLow": "{color.neutral.textLow}",
      "primary": "{color.brand.500}",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "{color.brand.100}",
      "onPrimaryContainer": "{color.brand.700}",
      "success": "{color.success.500}",
      "successContainer": "{color.success.container}",
      "rating": "{color.gold.500}",
      "error": "{color.error.500}",
      "errorContainer": "{color.error.container}",
      "skeleton": "{color.neutral.200}"
    },
    "dark": {
      "bg": "#141210",
      "surface": "#1E1B18",
      "surfaceSunken": "#141210",
      "border": "#332F2B",
      "borderStrong": "#5A554F",
      "overlay": "rgba(0,0,0,0.6)",
      "textHi": "#F7F5F2",
      "textMed": "#B7B2AC",
      "textLow": "#7C776F",
      "primary": "#FF7A26",
      "onPrimary": "#FFFFFF",
      "primaryContainer": "#3A2113",
      "onPrimaryContainer": "#FFB894",
      "success": "#33C06F",
      "successContainer": "#12301F",
      "rating": "#FFC633",
      "error": "#FF6B62",
      "errorContainer": "#3A1512",
      "skeleton": "#26221F"
    }
  },
  "space": { "2": 2, "4": 4, "6": 6, "8": 8, "10": 10, "12": 12, "14": 14, "16": 16, "20": 20, "24": 24, "32": 32, "40": 40 },
  "radius": { "xs": 4, "sm": 6, "md": 10, "lg": 12, "xl": 16, "2xl": 20, "3xl": 26, "pill": 999 },
  "elevation": {
    "1": [{ "x": 0, "y": 4, "blur": 12, "spread": 0, "color": "rgba(0,0,0,0.04)" }],
    "2": [{ "x": 0, "y": 8, "blur": 16, "spread": 0, "color": "rgba(0,0,0,0.03)" }, { "x": 0, "y": 4, "blur": 8, "spread": 0, "color": "rgba(0,0,0,0.02)" }],
    "nav": [{ "x": 0, "y": -8, "blur": 16, "spread": 0, "color": "rgba(0,0,0,0.03)" }],
    "brandGlow": [{ "x": 0, "y": 8, "blur": 16, "spread": 0, "color": "rgba(255,98,0,0.16)" }],
    "sheet": [{ "x": 0, "y": 12, "blur": 24, "spread": 0, "color": "rgba(0,0,0,0.06)" }]
  },
  "type": {
    "families": { "display": "Outfit", "body": "Inter" },
    "roles": {
      "display":  { "family": "display", "weight": 800, "size": 34, "height": 1.2 },
      "headline": { "family": "display", "weight": 800, "size": 24, "height": 1.25 },
      "titleLg":  { "family": "display", "weight": 800, "size": 20, "height": 1.25 },
      "titleMd":  { "family": "display", "weight": 700, "size": 16, "height": 1.25 },
      "titleSm":  { "family": "display", "weight": 600, "size": 15, "height": 1.27 },
      "price":    { "family": "display", "weight": 800, "size": 20, "height": 1.2 },
      "labelLg":  { "family": "body", "weight": 700, "size": 14, "height": 1.2 },
      "label":    { "family": "body", "weight": 700, "size": 13, "height": 1.23 },
      "labelSm":  { "family": "body", "weight": 600, "size": 11, "height": 1.2 },
      "bodyLg":   { "family": "body", "weight": 400, "size": 14, "height": 1.35 },
      "bodyMd":   { "family": "body", "weight": 400, "size": 13, "height": 1.25 },
      "caption":  { "family": "body", "weight": 400, "size": 12, "height": 1.2 },
      "captionXs":{ "family": "body", "weight": 400, "size": 10, "height": 1.2 }
    }
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 320, "sheet": 280 },
    "easing": { "standard": "cubic-bezier(0.2,0,0,1)", "accel": "cubic-bezier(0.3,0,1,1)" }
  }
}
