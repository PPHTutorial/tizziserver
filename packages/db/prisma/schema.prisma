// Stall — Prisma Schema (schema v2)
// Domains 0 (platform/config/system), 1 (identity/access), 2 (profiles).
// Domains 3–10 (catalog, orders, delivery, wallet, auction, comms, trust) land in Phases 2–6.
// See docs/02-DATA-MODEL.md. PostGIS geography columns get GiST indexes in the migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in prisma.config.ts (CLI) and the
  // PrismaClient driver adapter (runtime) — see ../src/index.ts.
}

// =====================================================================
// Enums
// =====================================================================

enum Role {
  CUSTOMER
  VENDOR
  COURIER
  STAFF
  ADMIN
}

enum PlatformStatus {
  ACTIVE
  DISABLED
}

enum FeatureValueType {
  BOOL
  NUMBER
  JSON
}

enum AppConfigScope {
  GLOBAL
  PLATFORM
}

enum PricingRuleScope {
  DELIVERY
  SERVICE_FEE
  BOOST
  SURGE
  TAX
}

enum FeeParty {
  VENDOR
  COURIER
}

enum FeeKind {
  COMMISSION
  PAYOUT
  LISTING
  WITHDRAWAL
}

enum ActorType {
  USER
  SYSTEM
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum UserRoleStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum KycStatus {
  NONE
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum CredentialKind {
  PASSWORD
  PIN
  TOTP
  RECOVERY
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum SocialProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
  VERIFY_EMAIL
  RESET_PASSWORD
  RESET_PIN
}

enum AuthResult {
  SUCCESS
  FAILED
  BLOCKED
}

enum AddressKind {
  HOME
  WORK
  OTHER
}

enum ProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum CourierOnlineStatus {
  OFFLINE
  ONLINE
  ON_JOB
}

enum PayoutAccountOwner {
  VENDOR
  COURIER
}

enum PayoutMethod {
  BANK
  MOMO
}

enum VehicleKind {
  BICYCLE
  MOTORBIKE
  CAR
  VAN
  TRUCK
  OTHER
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum KycSubject {
  VENDOR
  COURIER
}

// --- Domain 3 (catalog) ---------------------------------------------

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SUSPENDED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum OfferStatus {
  ACTIVE
  PAUSED
  OUT_OF_STOCK
}

enum PromotionKind {
  FLASH_DEAL
  CAMPAIGN
  BANNER
}

// =====================================================================
// Domain 0 — Platform & configuration
// =====================================================================

model Region {
  code         String   @id
  name         String
  currencyCode String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  regionRules RegionRule[]

  @@map("regions")
}

model Currency {
  code       String @id // ISO 4217
  name       String
  symbol     String
  minorUnits Int    @default(2)

  @@map("currencies")
}

model ExchangeRate {
  id        String   @id @default(cuid(2))
  baseCode  String
  quoteCode String
  rate      Decimal  @db.Decimal(18, 8)
  asOf      DateTime

  @@unique([baseCode, quoteCode, asOf])
  @@map("exchange_rates")
}

model Platform {
  slug             String         @id
  name             String
  defaultCurrency  String         @default("GHS")
  supportedRegions String[]
  theme            Json?
  status           PlatformStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  features PlatformFeature[]
  configs  AppConfig[]

  @@map("platforms")
}

model FeatureFlag {
  key         String           @id
  description String
  valueType   FeatureValueType @default(BOOL)
  createdAt   DateTime         @default(now())

  platformValues PlatformFeature[]
  roleValues     RoleFeature[]
  userOverrides  UserFeatureOverride[]
  regionRules    RegionRule[]

  @@map("feature_flags")
}

model PlatformFeature {
  id           String @id @default(cuid(2))
  platformSlug String
  flagKey      String
  value        Json

  platform Platform    @relation(fields: [platformSlug], references: [slug], onDelete: Cascade)
  flag     FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([platformSlug, flagKey])
  @@map("platform_features")
}

model RoleFeature {
  id      String @id @default(cuid(2))
  role    Role
  flagKey String
  value   Json

  flag FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([role, flagKey])
  @@map("role_features")
}

model UserFeatureOverride {
  id        String    @id @default(cuid(2))
  userId    String
  flagKey   String
  value     Json
  reason    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flag FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([userId, flagKey])
  @@map("user_feature_overrides")
}

model RegionRule {
  id         String @id @default(cuid(2))
  regionCode String
  flagKey    String
  value      Json

  region Region      @relation(fields: [regionCode], references: [code], onDelete: Cascade)
  flag   FeatureFlag @relation(fields: [flagKey], references: [key], onDelete: Cascade)

  @@unique([regionCode, flagKey])
  @@map("region_rules")
}

model AppConfig {
  id           String         @id @default(cuid(2))
  key          String
  value        Json
  description  String?
  scope        AppConfigScope @default(GLOBAL)
  platformSlug String?
  updatedAt    DateTime       @updatedAt

  platform Platform? @relation(fields: [platformSlug], references: [slug], onDelete: Cascade)

  @@unique([key, platformSlug])
  @@map("app_config")
}

model PricingRule {
  id           String           @id @default(cuid(2))
  scope        PricingRuleScope
  platformSlug String?
  regionCode   String?
  vehicleType  VehicleKind?
  params       Json
  priority     Int              @default(0)
  activeFrom   DateTime?
  activeTo     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([scope, platformSlug])
  @@map("pricing_rules")
}

model FeeSchedule {
  id           String    @id @default(cuid(2))
  party        FeeParty
  kind         FeeKind
  params       Json
  platformSlug String?
  activeFrom   DateTime?
  activeTo     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([party, kind, platformSlug])
  @@map("fee_schedules")
}

model IdempotencyKey {
  id               String   @id @default(cuid(2))
  key              String   @unique
  principalId      String?
  route            String
  requestHash      String
  responseSnapshot Json?
  statusCode       Int?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Transactional outbox — appended in the same tx as a domain write, relayed to
/// Redis pub/sub by the worker. Append-only (no updatedAt).
model OutboxEvent {
  id            String    @id @default(cuid(2))
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  dispatchedAt  DateTime?

  @@index([dispatchedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model Webhook {
  id           String   @id @default(cuid(2))
  url          String
  secret       String
  events       String[]
  platformSlug String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id            String    @id @default(cuid(2))
  webhookId     String
  eventId       String?
  status        String
  attempts      Int       @default(0)
  responseCode  Int?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, status])
  @@map("webhook_deliveries")
}

/// Append-only audit trail for auth events, role/permission changes, money
/// movement, KYC decisions, admin actions, feature-flag edits.
model AuditLog {
  id         String    @id @default(cuid(2))
  actorId    String?
  actorType  ActorType @default(USER)
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  ua         String?
  at         DateTime  @default(now())

  @@index([targetType, targetId])
  @@index([actorId, at])
  @@map("audit_logs")
}

// =====================================================================
// Domain 1 — Identity & access
// =====================================================================

model User {
  id          String     @id @default(cuid(2))
  phone       String     @unique
  email       String?    @unique
  firstName   String?
  lastName    String?
  avatar      String?
  status      UserStatus @default(PENDING_VERIFICATION)
  locale      String     @default("en")
  timezone    String?
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  roles            UserRole[]
  credentials      Credential[]
  sessions         Session[]
  devices          Device[]
  socialIdentities SocialIdentity[]
  otps             Otp[]
  loginActivity    LoginActivity[]
  featureOverrides UserFeatureOverride[]
  tokenEpoch       TokenEpoch?

  customerProfile CustomerProfile?
  vendorProfile   VendorProfile?
  courierProfile  CourierProfile?
  addresses       Address[]
  savedLocations  SavedLocation[]

  productQuestions ProductQuestion[]
  productAnswers   ProductAnswer[]
  productReviews   ProductReview[]
  wishlist         WishlistItem[]
  recentlyViewed   RecentlyViewed[]

  @@map("users")
}

model UserRole {
  id          String         @id @default(cuid(2))
  userId      String
  role        Role
  status      UserRoleStatus @default(PENDING)
  kycStatus   KycStatus      @default(NONE)
  activatedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model Credential {
  id         String         @id @default(cuid(2))
  userId     String
  kind       CredentialKind
  secretHash String
  params     Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@map("credentials")
}

/// Rotating refresh-token session. `familyId` groups a rotation chain; presenting
/// a `rotatedFromId` that is already rotated ⇒ reuse detected ⇒ revoke the family.
model Session {
  id            String    @id @default(cuid(2))
  userId        String
  deviceId      String?
  refreshHash   String    @unique
  familyId      String
  activeRole    Role      @default(CUSTOMER)
  platformSlug  String?
  userAgent     String?
  ip            String?
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  rotatedFromId String?   @unique
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Device {
  id         String         @id @default(cuid(2))
  userId     String
  deviceId   String         @unique
  platform   DevicePlatform
  model      String?
  pushToken  String?
  appVersion String?
  trusted    Boolean        @default(false)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model SocialIdentity {
  id             String         @id @default(cuid(2))
  userId         String
  provider       SocialProvider
  providerUserId String
  email          String?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@map("social_identities")
}

model Otp {
  id          String     @id @default(cuid(2))
  target      String // phone or email
  channel     OtpChannel
  codeHash    String
  purpose     OtpPurpose
  userId      String?
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([target, purpose])
  @@index([expiresAt])
  @@map("otps")
}

/// Append-only.
model LoginActivity {
  id       String     @id @default(cuid(2))
  userId   String?
  deviceId String?
  ip       String?
  ua       String?
  geo      String?
  result   AuthResult
  reason   String?
  at       DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@map("login_activity")
}

/// Bump `ver` to invalidate every outstanding access token for a user.
model TokenEpoch {
  userId    String   @id
  ver       Int      @default(1)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_epochs")
}

// =====================================================================
// Domain 2 — Profiles
// =====================================================================

model CustomerProfile {
  id               String   @id @default(cuid(2))
  userId           String   @unique
  defaultAddressId String?
  marketingOptIn   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model Address {
  id            String                                 @id @default(cuid(2))
  userId        String
  label         String?
  recipientName String
  phone         String
  line1         String
  line2         String?
  city          String
  region        String?
  country       String
  postalCode    String?
  location      Unsupported("geography(Point, 4326)")?
  isDefault     Boolean                                @default(false)
  kind          AddressKind                            @default(HOME)
  createdAt     DateTime                               @default(now())
  updatedAt     DateTime                               @updatedAt
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model SavedLocation {
  id        String                                @id @default(cuid(2))
  userId    String
  name      String
  location  Unsupported("geography(Point, 4326)")
  address   String?
  createdAt DateTime                              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_locations")
}

model VendorProfile {
  id          String        @id @default(cuid(2))
  userId      String        @unique
  displayName String
  bio         String?
  logo        String?
  banner      String?
  status      ProfileStatus @default(PENDING)
  verifiedAt  DateTime?
  ratingAvg   Float         @default(0)
  ratingCount Int           @default(0)
  platformIds String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  business  Business?
  products  Product[]
  offers    VendorOffer[]
  inventory Inventory[]

  @@map("vendor_profiles")
}

model Business {
  id          String                                 @id @default(cuid(2))
  vendorId    String                                 @unique
  legalName   String
  regNumber   String?
  taxId       String?
  category    String?
  phones      String[]
  email       String?
  website     String?
  addressLine String?
  city        String?
  region      String?
  country     String?
  location    Unsupported("geography(Point, 4326)")?
  createdAt   DateTime                               @default(now())
  updatedAt   DateTime                               @updatedAt

  vendor    VendorProfile      @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documents BusinessDocument[]

  @@map("businesses")
}

model BusinessDocument {
  id           String    @id @default(cuid(2))
  businessId   String
  type         String
  fileKey      String
  status       DocStatus @default(PENDING)
  reviewedById String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("business_documents")
}

model PayoutAccount {
  id        String             @id @default(cuid(2))
  ownerType PayoutAccountOwner
  ownerId   String
  method    PayoutMethod
  details   Json // tokenized
  verified  Boolean            @default(false)
  isDefault Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([ownerType, ownerId])
  @@map("payout_accounts")
}

model CourierProfile {
  id                  String                                 @id @default(cuid(2))
  userId              String                                 @unique
  status              ProfileStatus                          @default(PENDING)
  onlineStatus        CourierOnlineStatus                    @default(OFFLINE)
  lastLocation        Unsupported("geography(Point, 4326)")?
  lastLocationAt      DateTime?
  ratingAvg           Float                                  @default(0)
  ratingCount         Int                                    @default(0)
  completedDeliveries Int                                    @default(0)
  acceptanceRate      Float                                  @default(0)
  cancellationRate    Float                                  @default(0)
  level               Json?
  activeVehicleId     String?
  createdAt           DateTime                               @default(now())
  updatedAt           DateTime                               @updatedAt
  deletedAt           DateTime?

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles     CourierVehicle[]
  availability CourierAvailability[]
  shifts       CourierShift[]
  serviceAreas CourierServiceArea[]

  @@map("courier_profiles")
}

model CourierAvailability {
  id        String  @id @default(cuid(2))
  courierId String
  dayOfWeek Int // 0 = Sunday
  startTime String // "HH:MM"
  endTime   String
  enabled   Boolean @default(true)

  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@unique([courierId, dayOfWeek])
  @@map("courier_availability")
}

model CourierShift {
  id            String    @id @default(cuid(2))
  courierId     String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  onlineSeconds Int       @default(0)
  deliveries    Int       @default(0)
  earningsMinor Int       @default(0)

  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId])
  @@map("courier_shifts")
}

model CourierVehicle {
  id        String      @id @default(cuid(2))
  courierId String
  type      VehicleKind
  make      String?
  model     String?
  color     String?
  plate     String?
  year      Int?
  photos    String[]
  status    DocStatus   @default(PENDING)
  capacity  Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  courier   CourierProfile           @relation(fields: [courierId], references: [id], onDelete: Cascade)
  documents CourierVehicleDocument[]

  @@index([courierId])
  @@map("courier_vehicles")
}

model CourierVehicleDocument {
  id        String    @id @default(cuid(2))
  vehicleId String
  type      String
  fileKey   String
  status    DocStatus @default(PENDING)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  vehicle CourierVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("courier_vehicle_documents")
}

model CourierServiceArea {
  id        String                                   @id @default(cuid(2))
  courierId String
  name      String
  area      Unsupported("geography(Polygon, 4326)")?
  radiusM   Int?
  centerLat Float?
  centerLng Float?
  enabled   Boolean                                  @default(true)
  createdAt DateTime                                 @default(now())
  updatedAt DateTime                                 @updatedAt

  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId])
  @@map("courier_service_areas")
}

// =====================================================================
// Domain 2b — KYC review case (vendor / courier onboarding)
// =====================================================================

/// One review case per (subject, type). A mock reviewer flips `status` in dev.
model KycCase {
  id           String     @id @default(cuid(2))
  subjectType  KycSubject
  subjectId    String
  status       KycStatus  @default(PENDING)
  platformSlug String?
  fields       Json?
  note         String?
  reviewedById String?
  submittedAt  DateTime   @default(now())
  reviewedAt   DateTime?
  updatedAt    DateTime   @updatedAt

  @@unique([subjectType, subjectId])
  @@index([status])
  @@map("kyc_cases")
}

// =====================================================================
// Domain 3 — Catalog
// =====================================================================

/// Category tree. `path` is a materialised "/a/b/c" slug chain for cheap subtree
/// queries; `platformSlugs` scopes a branch to tenants (empty ⇒ all).
model Category {
  id            String   @id @default(cuid(2))
  parentId      String?
  slug          String   @unique
  name          String
  icon          String?
  path          String   @default("/")
  platformSlugs String[]
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@index([path])
  @@map("categories")
}

/// Base product, owned by the creating vendor. Sold through one or more
/// `VendorOffer`s (multi-vendor). `searchVector` is maintained in migration SQL.
model Product {
  id            String                   @id @default(cuid(2))
  vendorId      String
  categoryId    String
  title         String
  slug          String                   @unique
  description   String
  brand         String?
  condition     ProductCondition         @default(NEW)
  attributes    Json?
  status        ProductStatus            @default(DRAFT)
  platformSlugs String[]
  ratingAvg     Float                    @default(0)
  ratingCount   Int                      @default(0)
  searchVector  Unsupported("tsvector")?
  publishedAt   DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?

  vendor     VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category   Category          @relation(fields: [categoryId], references: [id])
  media      ProductMedia[]
  variants   ProductVariant[]
  offers     VendorOffer[]
  questions  ProductQuestion[]
  reviews    ProductReview[]
  wishedBy   WishlistItem[]
  views      RecentlyViewed[]
  promoItems PromotionItem[]

  @@index([vendorId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductMedia {
  id        String    @id @default(cuid(2))
  productId String
  kind      MediaKind @default(IMAGE)
  fileKey   String
  alt       String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model ProductVariant {
  id             String   @id @default(cuid(2))
  productId      String
  sku            String   @unique
  name           String
  options        Json?
  priceMinor     Int
  compareAtMinor Int?
  barcode        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory Inventory[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id                String    @id @default(cuid(2))
  variantId         String
  vendorId          String
  quantity          Int       @default(0)
  reserved          Int       @default(0)
  restockAt         DateTime?
  lowStockThreshold Int       @default(0)
  updatedAt         DateTime  @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  vendor  VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([variantId, vendorId])
  @@map("inventory")
}

/// A seller's listing of a product: same `productId`, several vendors.
model VendorOffer {
  id         String           @id @default(cuid(2))
  productId  String
  vendorId   String
  priceMinor Int
  currency   String           @default("GHS")
  condition  ProductCondition @default(NEW)
  fulfilment Json?
  status     OfferStatus      @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor       VendorProfile       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  priceHistory PriceHistory[]
  gasListing   GasCylinderListing?

  @@unique([productId, vendorId])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_offers")
}

model PriceHistory {
  id         String   @id @default(cuid(2))
  offerId    String
  priceMinor Int
  at         DateTime @default(now())

  offer VendorOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, at])
  @@map("price_history")
}

model ProductQuestion {
  id        String   @id @default(cuid(2))
  productId String
  userId    String
  body      String
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ProductAnswer[]

  @@index([productId])
  @@map("product_questions")
}

model ProductAnswer {
  id           String   @id @default(cuid(2))
  questionId   String
  answeredById String
  body         String
  createdAt    DateTime @default(now())

  question ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [answeredById], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("product_answers")
}

model ProductReview {
  id        String   @id @default(cuid(2))
  productId String
  userId    String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@map("product_reviews")
}

model WishlistItem {
  id        String   @id @default(cuid(2))
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id        String   @id @default(cuid(2))
  userId    String
  productId String
  at        DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, at])
  @@map("recently_viewed")
}

/// Tizzi-Gas-specific attributes hang off the offer, never the order.
model GasCylinderListing {
  id               String  @id @default(cuid(2))
  offerId          String  @unique
  cylinderType     String
  weightKg         Float
  capacityL        Float
  requiresExchange Boolean @default(true)
  depositMinor     Int     @default(0)

  offer VendorOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("gas_cylinder_listings")
}

// =====================================================================
// Domain 8 (read side) — Promotions: flash deals, campaigns, banners
// =====================================================================

model Promotion {
  id            String        @id @default(cuid(2))
  slug          String        @unique
  kind          PromotionKind
  title         String
  subtitle      String?
  imageKey      String?
  ctaRoute      String?
  platformSlugs String[]
  priority      Int           @default(0)
  isActive      Boolean       @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items PromotionItem[]

  @@index([kind])
  @@map("promotions")
}

model PromotionItem {
  id          String @id @default(cuid(2))
  promotionId String
  productId   String
  /// flash-deal discount in basis points (500 = 5%); null for campaigns/banners.
  discountBps Int?
  sortOrder   Int    @default(0)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([productId])
  @@map("promotion_items")
}
