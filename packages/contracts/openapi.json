{
  "openapi": "3.0.3",
  "info": {
    "title": "GrandPrice API",
    "version": "0.0.0-phase0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Liveness + build info",
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "env": {
                          "type": "string"
                        },
                        "ts": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "service",
                        "version",
                        "env",
                        "ts"
                      ],
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "traceId": {
                          "type": "string"
                        },
                        "page": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "ok",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/config/bootstrap": {
      "get": {
        "summary": "Per-platform capability + nav bootstrap for a client on launch",
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "platform": {
                          "type": "string"
                        },
                        "features": {
                          "type": "object",
                          "additionalProperties": {
                            "anyOf": [
                              {
                                "type": "boolean"
                              },
                              {
                                "type": "number"
                              },
                              {
                                "type": "string"
                              }
                            ]
                          }
                        },
                        "nav": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "key": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              },
                              "icon": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "key",
                              "label",
                              "icon"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "minAppVersion": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "platform",
                        "features",
                        "nav",
                        "minAppVersion"
                      ],
                      "additionalProperties": false
                    },
                    "error": {
                      "type": "string",
                      "nullable": true,
                      "enum": [
                        null
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "traceId": {
                          "type": "string"
                        },
                        "page": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 0,
                          "exclusiveMinimum": true,
                          "maximum": 9007199254740991
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "ok",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
