# Copy to .env at the repo root and adjust. Never commit .env.
# Do NOT set NODE_ENV here — the tooling sets it (next dev/build, tsx). Setting
# it to "development" breaks `next build`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Docker (infra/docker/docker-compose.yml) — the default:
DATABASE_URL=postgresql://stall:stall@localhost:5432/stall?schema=public
DATABASE_POOLING_URL=postgresql://stall:stall@localhost:5432/stall?schema=public
# No-Docker alt (`pnpm dev:db` — trust-auth cluster in ./.pgdata):
# DATABASE_URL=postgresql://postgres@localhost:5432/stall?schema=public
POSTGRES_USER=stall
POSTGRES_PASSWORD=stall
POSTGRES_DB=stall
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Only used by infra/docker/docker-compose.prod.yml (the self-hosted stack —
# see infra/terraform/selfhost/README.md); dev Redis above has no auth.
REDIS_PASSWORD=change-me-in-.env.prod

# --- Self-hosted production (infra/docker/docker-compose.prod.yml) --------
# The public domain Caddy requests a Let's Encrypt cert for. Unused in dev.
DOMAIN=stall.example

# --- Object storage (MinIO local) -------------------------------------
MINIO_ROOT_USER=stall
MINIO_ROOT_PASSWORD=stall-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=stall
S3_SECRET_ACCESS_KEY=stall-secret
S3_BUCKET=stall-media
# `mock` writes invoice PDFs etc. to local disk — no MinIO/Docker required.
# Flip to `s3` once the bucket above is actually reachable.
STORAGE_PROVIDER=mock
STORAGE_MOCK_DIR=./.storage-mock

# --- Email sandbox ---------------------------------------------------
# `pnpm dev:mail` runs maildev (SMTP :1025, web UI http://localhost:1080)
# — or Mailpit via Docker (web UI :8025). Both need no credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Stall <no-reply@stall.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Auth / JWT (v1; hardened in Phase 1) ---------------------------
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=60
# EdDSA dev keypair (regenerate for real deployments)
JWT_PRIVATE_KEY=MC4CAQAwBQYDK2VwBCIEIPvO0IQcigyf/bYxqxH01N7z+Tw4OPw8XCipshx+BSr0
JWT_PUBLIC_KEY=MCowBQYDK2VwAyEAKvMYnCyKVQUTN+Iw80vWk3UagyyqYdyjFFsG0D43Q5k=
JWT_ISSUER=stall
JWT_AUDIENCE=stall-app

# --- OTP / SMS ------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_LENGTH=6
# log = print codes to server log (dev); nalo | twilio in prod
SMS_PROVIDER=log


# --- Search (optional; docker profile "search") -------------------
MEILI_PORT=7700
MEILI_MASTER_KEY=stall-dev-key

# --- Push notifications (Firebase Cloud Messaging) ------------------
# Unset ⇒ pushToDevices() logs instead of sending (packages/core/src/comms).
# From a Firebase service-account JSON (Project settings → Service accounts
# → Generate new private key): project_id, client_email, private_key.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Platform ------------------------------------------------------
DEFAULT_PLATFORM=grandprice

# --- Road routing (OSRM) -------------------------------------------
# Defaults to the public demo server (fine for dev; not for production load).
# Point at a self-hosted OSRM container for production. Unset to force the
# straight-line haversine fallback (no road-following route polyline).
# OSRM_URL=https://router.project-osrm.org
