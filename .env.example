# Copy to .env at the repo root and adjust. Never commit .env.
# Do NOT set NODE_ENV here — the tooling sets it (next dev/build, tsx). Setting
# it to "development" breaks `next build`.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Docker (infra/docker/docker-compose.yml) — the default:
DATABASE_URL=postgresql://stall:stall@localhost:5432/stall?schema=public
DATABASE_POOLING_URL=postgresql://stall:stall@localhost:5432/stall?schema=public
# No-Docker alt (`pnpm dev:db` — trust-auth cluster in ./.pgdata):
# DATABASE_URL=postgresql://postgres@localhost:5432/stall?schema=public
POSTGRES_USER=stall
POSTGRES_PASSWORD=stall
POSTGRES_DB=stall
POSTGRES_PORT=5432

# --- Redis ---------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local) -------------------------------------
MINIO_ROOT_USER=stall
MINIO_ROOT_PASSWORD=stall-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=stall
S3_SECRET_ACCESS_KEY=stall-secret
S3_BUCKET=stall-media

# --- Email sandbox ---------------------------------------------------
# `pnpm dev:mail` runs maildev (SMTP :1025, web UI http://localhost:1080)
# — or Mailpit via Docker (web UI :8025). Both need no credentials.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Stall <no-reply@stall.local>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Auth / JWT (v1; hardened in Phase 1) ---------------------------
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# --- Search (optional; docker profile "search") -------------------
MEILI_PORT=7700
MEILI_MASTER_KEY=stall-dev-key

# --- Platform ------------------------------------------------------
DEFAULT_PLATFORM=grandprice
