# Copy to .env at the repo root and adjust. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (matches infra/docker/docker-compose.yml defaults) -----------
POSTGRES_USER=grandprice
POSTGRES_PASSWORD=grandprice
POSTGRES_DB=grandprice
POSTGRES_PORT=5432
DATABASE_URL=postgresql://grandprice:grandprice@localhost:5432/grandprice?schema=public
DATABASE_POOLING_URL=postgresql://grandprice:grandprice@localhost:5432/grandprice?schema=public

# --- Redis ---------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local) -------------------------------------
MINIO_ROOT_USER=grandprice
MINIO_ROOT_PASSWORD=grandprice-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=grandprice
S3_SECRET_ACCESS_KEY=grandprice-secret
S3_BUCKET=grandprice-media

# --- Email (Mailpit local) -------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GrandPrice <no-reply@grandprice.local>"

# --- Auth / JWT (v1; hardened in Phase 1) ---------------------------
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=60d

# --- Search (optional; docker profile "search") -------------------
MEILI_PORT=7700
MEILI_MASTER_KEY=grandprice-dev-key

# --- Platform ------------------------------------------------------
DEFAULT_PLATFORM=grandprice
